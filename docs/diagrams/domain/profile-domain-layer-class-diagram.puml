@startuml profile-domain-layer-class-diagram

title QualiTrack - Profile Management - Domain Layer Class Diagram

skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "shared" <<External>> {
  abstract class AbstractDomainAggregateRoot
}

package "profile.domain.model.valueobjects" {
  class PersonName <<record>> {
    + value: String
    + {static} tryParse(value: String): Optional<PersonName>
  }

  class Dni <<record>> {
    + value: String
  }

  class PhoneNumber <<record>> {
    + value: String
  }

  class Location <<record>> {
    + value: String
  }

  class PhotoImage <<record>> {
    + content: byte[]
    + contentType: String
    + {static} MAX_SIZE_BYTES: int
    + {static} of(content: byte[]): PhotoImage
    + size(): int
  }

  class ProfilePhoto <<record>> {
    + contentType: String
    + sizeBytes: int
    + updatedAt: Instant
    + {static} of(image: PhotoImage, uploadedAt: Instant): ProfilePhoto
  }

  class ProfileDetail <<record>> {
    + profile: Profile
    + username: String
    + email: String
    + roles: List<String>
    + staffId: Long
    + position: String
  }
}
note bottom of PhotoImage
  JPEG, PNG or WebP detected from the content
  (magic bytes), at most 2 MB.
end note

package "profile.domain.model.aggregates" {
  class Profile {
    - id: Long
    - userId: Long
    - fullName: PersonName
    - dni: Dni
    - phoneNumber: PhoneNumber
    - location: Location
    - photo: ProfilePhoto
    - updatedAt: Instant
    + update(fullName, dni, phoneNumber, location): boolean
    + changePhoto(image: PhotoImage, uploadedAt: Instant): void
    + removePhoto(): boolean
    + hasPhoto(): boolean
    + isStored(): boolean
    + getFullNameValue(): String
  }
}
Profile --|> AbstractDomainAggregateRoot
Profile --> PersonName
Profile --> Dni
Profile --> PhoneNumber
Profile --> Location
Profile --> ProfilePhoto
ProfilePhoto ..> PhotoImage
ProfileDetail --> Profile
note right of Profile
  One profile per IAM account, created the first time it is saved.
  A profile never saved starts with the name the quality manager
  registered for a staff member. Laboratory keeps the staff record;
  Profile keeps the personal data (DNI, location, photo).
end note

package "profile.domain.model.commands" {
  class UpdateProfileCommand <<record>> {
    + userId: Long
    + fullName: PersonName
    + dni: Dni
    + phoneNumber: PhoneNumber
    + location: Location
    + {static} of(userId, fullName, dni, phoneNumber, location): UpdateProfileCommand
  }

  class ChangeProfilePhotoCommand <<record>> {
    + userId: Long
    + image: PhotoImage
  }

  class RemoveProfilePhotoCommand <<record>> {
    + userId: Long
  }
}

package "profile.domain.model.queries" {
  class GetProfileByUserIdQuery <<record>> {
    + userId: Long
  }

  class GetProfilePhotoQuery <<record>> {
    + userId: Long
  }

  class GetStaffProfileQuery <<record>> {
    + laboratoryId: Long
    + staffId: Long
  }

  class GetStaffProfilePhotoQuery <<record>> {
    + laboratoryId: Long
    + staffId: Long
  }
}

package "profile.domain.model.events" {
  class ProfileUpdatedEvent <<record>> {
    + userId: Long
    + fullName: String
  }
}

package "profile.domain.repositories" {
  interface ProfileRepository {
    + findByUserId(userId: Long): Optional<Profile>
    + save(profile: Profile): Profile
  }
}
ProfileRepository --> Profile

@enduml
